{
 "id": "N05",
 "title": "switching 3 then 1 moves the accent rule back under Today",
 "spec": "coordinator, thc screen run 2026-10-11",
 "targets": [
  "thc-tui",
  "thc-screen"
 ],
 "vault": [
  [
   "todo",
   "Alpha task",
   "--due",
   "today",
   "--id",
   "aaaaaaaaaaaa"
  ],
  [
   "todo",
   "Beta task",
   "--due",
   "today",
   "--id",
   "bbbbbbbbbbbb"
  ],
  [
   "todo",
   "Gamma task",
   "--due",
   "tomorrow",
   "--id",
   "cccccccccccc"
  ]
 ],
 "steps": [
  {
   "key": "3"
  },
  {
   "assert": {
    "thc-tui": {
     "thc_state": {
      "view": "tasks"
     }
    },
    "thc-screen": {
