{
 "id": "S03",
 "title": "typing in a page aside shows in main; cmd z in main undoes it",
 "spec": "sidebar.md (thc screen on main) §7 (one document, two views)",
 "targets": [
  "thc-screen"
 ],
 "vault": [
  {
   "page": "Garden",
   "notes": [
    "Compost by the fence",
    "See [[Health]] for the rest"
   ]
  },
  {
   "page": "Health",
   "notes": [
    "Schedule annual physical"
   ]
  },
  [
   "todo",
   "Alpha task",
   "--due",
   "tomorrow"
  ],
  {
   "todo_under": "Health",
   "text": "Book the physical",
   "due": "today"
  }
 ],
 "steps": [
  {
   "key": "o"
  },
  {
   "assert": {
    "sidebar": {
     "kinds": [
      "page"
     ]
    }
   }
  },
  {
   "key": "4"
  },
  {
   "key": "down"
  },
  {
   "key": "enter"
  },
  {
   "assert": {
    "fictty_state": {
     "focus": "pages_doc"
    },
    "screen": "¶ Health"
   }
  },
  {
   "key": "a-s"
  },
  {
   "key": "c-home"
  },
  {
   "key": "end"
  },
  {
   "type": " (shared)"
  },
  {
   "assert": {
    "doc_contains": "physical (shared)",
    "screen": "physical (shared)"
   }
  },
  {
   "key": "esc"
  },
  {
   "key": "d-z"
  }
 ],
 "expect": {
  "doc_lacks": "(shared)",
  "fictty_state": {
   "focus": "pages_doc"
  }
 },
 "size": "140x40",
 "note": "Health aside (o on its task), Health in main (Pages: Garden is selected, ↓ Health, Enter); typed in the panel, undone from main"
}
