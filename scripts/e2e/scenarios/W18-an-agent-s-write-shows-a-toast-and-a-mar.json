{
 "id": "W18",
 "title": "an agent's write shows a toast and a mark; u undoes it, not after 5 s",
 "spec": "status.md §7.3 the agent toast",
 "targets": [
  "thc-screen"
 ],
 "vault": [
  [
   "todo",
   "Alpha task",
   "--due",
   "today"
  ],
  [
   "todo",
   "Beta task",
   "--due",
   "tomorrow"
  ]
 ],
 "steps": [
  {
   "wait": 500
  },
  {
   "thc": [
    "todo",
    "Agent wrote this",
    "--due",
    "today"
   ],
   "actor": "claude"
  },
  {
   "assert": {
    "screen": "Agent wrote this",
    "bar_has": "claude",
    "row_has": {
