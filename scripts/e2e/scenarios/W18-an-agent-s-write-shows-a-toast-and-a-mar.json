   },
   "within": 3000
  },
  {
   "key": "u"
  },
  {
   "assert": {
    "vault": [
     {
      "q": "text:Agent",
      "count": 0
     }
    ],
    "no_screen": "Agent wrote this"
   },
   "within": 3000
  },
  {
   "thc": [
    "todo",
    "Second agent write",
    "--due",
    "today"
   ],
   "actor": "claude"
  },
  {
   "assert": {
    "screen": "Second agent write"
   },
   "within": 3000
  },
  {
   "wait": 5500
  },
  {
   "key": "u"
  },
  {
   "wait": 1000
  }
 ],
 "expect": {
  "vault": [
   {
    "q": "text:Second",
    "count": 1
   }
  ],
  "screen": "Second agent write"
 },
 "note": "the toast names the agent in the bar row and a • marks the row; u in the toast's 5 s undoes the write; after that u does nothing"
}
