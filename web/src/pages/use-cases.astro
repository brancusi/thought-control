---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { u } from '../lib/url';
const groups = (await getCollection('usecases')).sort((a, b) => a.data.order - b.data.order);
const bodies = await Promise.all(groups.map(async (g) => ({ g, Content: (await render(g)).Content })));
---
<Base title="Use cases" description="How people use Thought Control (thc): a day log, an agent task board, team vaults, research notes, capture from scripts, a bug tracker with screenshots." tab="use">
  <header class="page-head">
    <p class="kicker"><span class="blk" aria-hidden="true"></span>use cases · {groups.length} scenes</p>
    <h1>How people use it</h1>
    <p class="lede">Small scenes, with the commands that make them work. All the data is made up.</p>
  </header>
  <div class="grid">
    {groups.map((g) => (
      <a class="cell" href={`#${g.id}`}><Icon name={g.data.icon} /><h3>{g.data.title}</h3><p><span class="dim">{g.data.who} ·</span> {g.data.blurb}</p></a>
    ))}
  </div>
  {bodies.map(({ g, Content }, i) => (
    <section class="feature prose" id={g.id}>
      <div class="sec"><span class="n">{String(i + 1).padStart(2, '0')}</span> {g.data.title}</div>
      <div class="feature__body">
        <aside><Icon name={g.data.icon} size={40} /><p class="muted">{g.data.blurb}</p></aside>
        <div><Content /></div>
      </div>
    </section>
  ))}
</Base>
<style>
  .feature { scroll-margin-top: 24px; }
  .feature__body { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 40px; }
  .feature__body aside { color: var(--accent); }
  .feature__body aside p { font-size: 13px; }
  @media (max-width: 820px) { .feature__body { grid-template-columns: minmax(0, 1fr); gap: 8px; } .feature__body aside p { display: none; } }
</style>
