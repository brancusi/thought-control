---
// Built from the repo's RELEASE_NOTES.md (newest first) at build time. Each **x.y.z: title**
// heading becomes a release with an anchor.
import Base from '../layouts/Base.astro';
import { marked } from 'marked';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const src = readFileSync(resolve(process.cwd(), '../RELEASE_NOTES.md'), 'utf8');
const parts = src.split(/^\*\*(\d+\.\d+\.\d+)(?::\s*(.*?))?\*\*\s*$/m);
type Rel = { v: string; title: string; html: string };
const rels: Rel[] = [];
for (let i = 1; i < parts.length; i += 3) {
  rels.push({ v: parts[i], title: (parts[i + 1] ?? '').trim(), html: await marked.parse(parts[i + 2] ?? '') });
}
const minor = (v: string) => v.split('.').slice(0, 2).join('.');
const lines = [...new Set(rels.map((r) => minor(r.v)))];
---
<Base title="Changelog" description="Every Thought Control release, newest first: what changed and why it matters." tab="changelog">
  <header class="page-head">
    <p class="kicker"><span class="blk" aria-hidden="true"></span>changelog · {rels.length} releases</p>
    <h1>What changed</h1>
    <p class="lede">thc updates itself in the background. These are the notes it shows you, newest first.
      Releases before 0.9 include the Mac menu bar app, ThoughtBar, which is paused for now.</p>
    <p class="jump">{lines.map((l) => <a href={`#v${rels.find((r) => minor(r.v) === l)!.v.replace(/\./g, '-')}`}>{l}</a>)}</p>
  </header>
  {rels.map((r) => (
    <section class="rel" id={`v${r.v.replace(/\./g, '-')}`}>
      <h2><a href={`#v${r.v.replace(/\./g, '-')}`} class="v">{r.v}</a>{r.title && <span class="t">{r.title}</span>}</h2>
      <div class="prose" set:html={r.html} />
    </section>
  ))}
</Base>
<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.4ch 1.6ch; font: 12px var(--mono); }
  .jump a { color: var(--muted); text-decoration: none; }
  .jump a:hover { color: var(--accent); }
  .rel { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; border-top: 1px solid var(--line); padding-top: 22px; margin-top: 22px; scroll-margin-top: 24px; }
  .rel h2 { margin: 0; font-size: 15px; display: flex; flex-direction: column; gap: 6px; text-transform: none; }
  .rel h2 .v { color: var(--accent); text-decoration: none; font: 800 17px var(--mono); }
  .rel h2 .t { color: var(--muted); font: 500 14px/1.4 var(--sans); }
  .rel .prose > :first-child { margin-top: 0; }
  @media (max-width: 820px) { .rel { grid-template-columns: minmax(0, 1fr); gap: 8px; } }
</style>
