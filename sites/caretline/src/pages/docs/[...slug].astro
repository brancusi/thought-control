---
import { getCollection, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import { DOCS } from '../../lib/docs';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return DOCS.map((d) => {
    const entry = entries.find((e) => e.id === d.id);
    if (!entry) throw new Error(`docs/caretline has no ${d.id}.md`);
    return { params: { slug: d.slug || undefined }, props: { entry, doc: d } };
  });
}
const { entry, doc } = Astro.props;
const { Content, headings } = await render(entry);
const source = doc.id === 'readme' ? 'README.md' : `${doc.id}.md`;
---
<Docs title={doc.slug ? doc.title : 'Docs'} description={doc.blurb} id={doc.id} headings={headings} source={source}>
  <Content />
</Docs>
