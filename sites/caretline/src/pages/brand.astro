---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import FieldBoot from '../components/FieldBoot.astro';
import Mark from '../components/Mark.astro';

const files = [
  { f: 'caretline-wordmark-dark.svg', d: 'Wordmark, selected, for dark grounds' },
  { f: 'caretline-wordmark-light.svg', d: 'Wordmark, selected, for light grounds' },
  { f: 'caretline-wordmark-plain-dark.svg', d: 'Wordmark, plain, for dark grounds' },
  { f: 'caretline-wordmark-plain-light.svg', d: 'Wordmark, plain, for light grounds' },
  { f: 'caretline-lockup-dark.svg', d: 'Wordmark on its own dark tile' },
  { f: 'caretline-lockup-light.svg', d: 'Wordmark on its own light tile' },
  { f: 'caretline-mark-dark.svg', d: 'Mark on a dark tile (app icon, avatar)' },
  { f: 'caretline-mark-light.svg', d: 'Mark on a light tile' },
  { f: 'caretline-mark-bare-dark.svg', d: 'Mark, no tile, for dark grounds' },
  { f: 'caretline-mark-bare-light.svg', d: 'Mark, no tile, for light grounds' },
  { f: 'favicon.svg', d: 'Favicon: fewer, heavier streaks for 16–32 px' },
];
const colors = [
  { t: '--void', n: 'Void', d: 'The ground. Deep space with a hair of blue.', dark: '#08090D', light: '#F5F6F9' },
  { t: '--ink', n: 'Starlight', d: 'Text and the field’s glyphs.', dark: '#DCDFE8', light: '#141720' },
  { t: '--lit', n: 'Selection', d: 'The one colour. Lit cells, the caret, the current thing.', dark: '#A396FF', light: '#5338F0' },
  { t: '--lit-ink', n: 'Knockout', d: 'A glyph cut out of a lit cell.', dark: '#08090D', light: '#FFFFFF' },
  { t: '--dim', n: 'Far star', d: 'Labels, comments, the status row.', dark: '#7D8396', light: '#5D6377' },
  { t: '--rule', n: 'Hairline', d: 'Frame edges and table rules.', dark: '#222634', light: '#DDE0E8' },
];
---
<Base title="Brand" description="The caretline logo, colours and type, with the files to download and the rules for using them." nav="brand">
  <main class="wrap brand-page">
    <header class="section__head" style="margin-top:var(--s-12)">
      <span class="label">brand</span>
      <h1 style="font-size:var(--t-xl)">The selection is the logo.</h1>
      <p>caretline's identity comes from one live demo: full-screen ASCII art pushed into the real editor, with the brightest cells sent as selections so the frame read in two tones. The wordmark is the word that sat in the middle of the warp field, selected, with the caret after it.</p>
    </header>

    <section class="b-grid">
      <figure class="b-card b-card--wide">
        <Field scene="warp" cols={124} rows={24} title="animated logo" label="CARETLINE, selected, with stars streaming past" speed={0.9} still={3.1} />
        <figcaption>The animated logo: the warp field on the frame clock, the word lit like a selection, the caret blinking at 530 ms. Under reduced motion it holds one still frame.</figcaption>
      </figure>
      <figure class="b-card b-card--dark">
        <img src="/brand/caretline-wordmark-dark.svg" alt="caretline wordmark: C A R E T L I N E knocked out of a lit selection band, then a caret" />
        <figcaption>Selected wordmark. The letters are cut out of the band, so it sits on any dark ground.</figcaption>
      </figure>
      <figure class="b-card b-card--light">
        <img src="/brand/caretline-wordmark-light.svg" alt="caretline wordmark for light grounds" />
        <figcaption>On light grounds the selection deepens; the knockout stays.</figcaption>
      </figure>
      <figure class="b-card b-card--dark">
        <img src="/brand/caretline-wordmark-plain-dark.svg" alt="caretline plain wordmark for dark grounds" />
        <figcaption>Plain wordmark, for busy grounds and small sizes. The caret keeps the colour.</figcaption>
      </figure>
      <figure class="b-card b-card--marks">
        <div class="b-marks">
          <img src="/brand/caretline-mark-dark.svg" width="96" height="96" alt="caretline mark: a caret in a burst of warp streaks" />
          <img src="/brand/caretline-mark-light.svg" width="96" height="96" alt="caretline mark on a light tile" />
          <img src="/brand/favicon.svg" width="32" height="32" alt="caretline favicon" />
          <img src="/brand/favicon.svg" width="16" height="16" alt="" />
        </div>
        <figcaption>The mark: a caret at the centre of a warp field. Streaks taper toward it, the way the stars stream outward. Below 32 px, use the favicon cut.</figcaption>
      </figure>
    </section>

    <section class="section" style="padding-top:var(--s-16)">
      <div class="section__head"><span class="label">colour</span><h2>Ink on the void, and one colour.</h2><p>Everything is starlight on deep space, except the selection. Use the lit colour for what is current: the caret, a selected run, the hottest cells of a frame. Never for decoration.</p></div>
      <div class="swatches">
        {colors.map((c) => (
          <div class="swatch">
            <div class="swatch__chip" style={`background:var(${c.t})`}></div>
            <p><b>{c.n}</b> <code>{c.t}</code></p>
            <p class="muted">{c.d}</p>
            <p class="dim mono">{c.dark} dark · {c.light} light</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section" style="padding-top:var(--s-16)">
      <div class="section__head"><span class="label">type</span><h2>Monospace first.</h2><p>Geist Mono sets the logo, headings, labels, code and every number. Geist sets long prose. Both are free (SIL Open Font License).</p></div>
      <div class="type">
        <p class="type__mono">The text editor as a state machine.</p>
        <p class="type__sans">Every input is a message, and any session can be saved, sent, replayed or shared live with an agent.</p>
      </div>
    </section>

    <section class="section" style="padding-top:var(--s-16)">
      <div class="section__head"><span class="label">rules</span><h2>Using the logo.</h2></div>
      <ul class="rules">
        <li><b>Keep the caret.</b> It is part of the wordmark. It sits one cell after the band and is never a separate decoration.</li>
        <li><b>Keep the letter spacing.</b> One cell between letters, exactly as the editor drew it. Don't tighten it into a word.</li>
        <li><b>One lit thing per view.</b> Next to the selected wordmark, nothing else is lit. Use the plain wordmark beside a lit button.</li>
        <li><b>Clear space is one cell</b> on every side of the band: the width of one letter.</li>
        <li><b>Minimum sizes:</b> the selected wordmark at 96 px wide, the plain one at 72 px, the mark at 32 px. Below that, the favicon cut.</li>
        <li><b>Don't</b> recolour the band, add gradients, glows or shadows, outline the letters, or set the word in another face.</li>
        <li><b>Animate only on the frame clock.</b> The warp field runs from time, honours reduced motion, and pauses when it is off screen.</li>
        <li>In plain text, write <code>caretline</code> in lower case. The caps are for the spaced wordmark.</li>
      </ul>
    </section>

    <section class="section" style="padding-top:var(--s-16)">
      <div class="section__head"><span class="label">files</span><h2>Download.</h2><p>SVG, with the letters as outlines, so they need no font.</p></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>File</th><th>Use</th></tr></thead>
          <tbody>{files.map((f) => <tr><td><a class="mono" href={`/brand/${f.f}`} download>{f.f}</a></td><td class="muted">{f.d}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
  </main>
  <FieldBoot />
</Base>

<style>
  .b-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); }
  @media (max-width: 44rem) { .b-grid { grid-template-columns: minmax(0, 1fr); } }
  .b-card { margin: 0; display: grid; gap: var(--s-4); align-content: space-between; padding: var(--s-8) var(--s-6) var(--s-4); border: 1px solid var(--rule); min-width: 0; }
  .b-card img { justify-self: center; width: min(100%, 26rem); height: auto; }
  .b-card figcaption { font-size: var(--t-sm); color: var(--muted); }
  .b-card--wide { grid-column: 1 / -1; padding: 0; border: 0; }
  .b-card--wide figcaption { padding-inline: 0; }
  .b-card--dark { background: #08090d; }
  .b-card--dark figcaption { color: #a4a9ba; }
  .b-card--light { background: #f5f6f9; }
  .b-card--light figcaption { color: #3f4456; }
  .b-marks { display: flex; flex-wrap: wrap; gap: var(--s-6); align-items: end; justify-content: center; }
  .b-marks img { width: auto; }
  .swatches { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-8) var(--s-6); }
  @media (max-width: 52rem) { .swatches { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .swatch { display: grid; gap: var(--s-1); font-size: var(--t-sm); }
  .swatch__chip { height: 4.5rem; border: 1px solid var(--rule-strong); margin-bottom: var(--s-2); }
  .swatch .mono { font-size: var(--t-xs); }
  .type { display: grid; gap: var(--s-6); border-top: 1px solid var(--rule); padding-top: var(--s-6); }
  .type__mono { font: 500 var(--t-xl)/1.15 var(--font-mono); letter-spacing: -0.03em; }
  .type__sans { font: 400 var(--t-md)/1.55 var(--font-sans); color: var(--muted); max-width: 52ch; }
  .rules { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4) var(--s-8); max-width: 62rem; }
  @media (max-width: 52rem) { .rules { grid-template-columns: minmax(0, 1fr); } }
  .rules li { color: var(--muted); padding-top: var(--s-3); border-top: 1px solid var(--rule); }
  .rules b { color: var(--ink); font-weight: 600; }
</style>
