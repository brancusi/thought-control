---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="No page at this address.">
  <main class="wrap" style="padding-block:var(--s-24)">
    <pre class="nf" aria-hidden="true">{`{"error":{"kind":"not_found","message":"no page at this address"}}`}</pre>
    <h1 style="font-size:var(--t-xl);margin-top:var(--s-6)">Nothing here.<span class="caret-bar" aria-hidden="true"></span></h1>
    <p class="muted" style="margin-top:var(--s-4)">Try <a href="/docs/">the docs</a> or <a href="/">the start</a>.</p>
  </main>
</Base>
<style>.nf { background: none; border: 0; padding: 0; color: var(--dim); white-space: pre-wrap; }</style>
