---
// Loads the field renderer once per page and mounts every [data-field] figure.
---
<script is:inline src="/js/field.js"></script>
<script is:inline>
  (function () {
    const F = window.CaretlineField;
    if (!F) return;
    document.querySelectorAll('[data-field]').forEach(function (fig) {
      const canvas = fig.querySelector('canvas');
      const stats = fig.querySelector('[data-stats]');
      const btn = fig.querySelector('[data-toggle]');
      let shown = 0;
      const field = new F.Field(canvas, {
        scene: fig.dataset.field,
        cols: +fig.dataset.cols, rows: +fig.dataset.rows,
        speed: +fig.dataset.speed || 1, still: +fig.dataset.still || 2.4,
        fixedRows: fig.hasAttribute('data-fixed-rows'), minCell: +fig.dataset.minCell || 5.2,
        onStats: function (s, f) {
          const now = performance.now();
          if (now - shown < 250 || !stats) return;
          shown = now;
          const ms = s.ms;
          const head = ms > 0 ? Math.round(1000 / ms) : 0;
          stats.textContent = f.paused
            ? 'paused · ' + ms.toFixed(2) + ' ms a frame'
            : fig.offsetWidth > 640
              ? Math.round(s.fps) + ' fps · ' + ms.toFixed(2) + ' ms a frame · room for ' + head.toLocaleString('en') + ' fps'
              : fig.offsetWidth > 340 ? Math.round(s.fps) + ' fps · ' + ms.toFixed(2) + ' ms' : Math.round(s.fps) + ' fps';
        },
      });
      fig._field = field;
      if (btn) {
        const label = function () { btn.textContent = field.paused ? 'play' : 'pause'; };
        label();
        btn.addEventListener('click', function () { field.toggle(); label(); });
      }
    });
  })();
</script>
