---
// "Try it in one line": the installer one-liner, then the demos, each with a copy button.
const ONE = 'curl -fsSL https://caretline.app/install.sh | sh && caretline demo';
const demos = [
  { cmd: 'caretline demo', what: 'the tour' },
  { cmd: 'caretline demo scenes', what: 'ASCII scenes' },
  { cmd: 'caretline demo agent', what: 'an agent beside you' },
];
---
<div class="try">
  <p class="try__label"><span class="label">try it in one line</span><span class="try__os">macOS · Linux</span></p>
  <div class="install install--try"><code>{ONE}</code><button type="button" data-copy-text={ONE} aria-label="Copy the one-line install and tour">copy</button></div>
  <ul class="try__demos">
    {demos.map((d) => (
      <li><button type="button" class="try__demo" data-copy-text={d.cmd} aria-label={`Copy ${d.cmd}`}>{d.cmd}</button><span class="dim">{d.what}</span></li>
    ))}
  </ul>
  <p class="try__alt dim">or <code>cargo install --git https://github.com/brancusi/thought-control caretline-app</code> · <a href="/docs/quickstart/">Quickstart</a></p>
</div>
<style>
  .try { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-3); min-width: 0; }
  .try__label { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); }
  .try__os { font: 400 var(--t-xs)/1 var(--font-mono); color: var(--dim); }
  .install--try { width: 100%; min-width: 0; border-color: var(--lit-line); }
  .install--try code { flex: 1; min-width: 0; white-space: normal; overflow-wrap: anywhere; overflow: visible; }
  .try__demos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); font: 400 var(--t-xs)/1.4 var(--font-mono); }
  .try__demos li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .try__demo { border: 1px solid var(--rule-strong); background: var(--panel); color: var(--ink); font: inherit; padding: 0.35rem 0.55rem; cursor: pointer; border-radius: 2px; }
  .try__demo:hover { border-color: var(--lit); }
  .try__demo code { font-size: 1em; }
  .try__alt { font: 400 var(--t-xs)/1.5 var(--font-mono); overflow-wrap: anywhere; }
  .try__alt code { font-size: 1em; }
</style>
