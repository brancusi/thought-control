---
// The tour, as frames rendered by the real binary (`caretline demo --snapshot --keys …`,
// scripts/tour-frames.mjs). The first frame is in the page; the rest load and play on view.
import data from '../../public/tour/frames.json';
const first = data.frames[0].html;
---
<figure class="tp" data-tour-preview>
  <div class="tp__bar"><span class="tp__dots" aria-hidden="true">● ● ●</span><span>$ caretline demo</span><span class="dim">{data.size}</span></div>
  <pre class="tp__screen" aria-label="caretline demo: a guided tour in the terminal: typing, several carets at once, undo, indenting, folding, a second view and dumping the state"><Fragment set:html={first} /></pre>
  <figcaption class="dim">Frames from the real binary, <code>caretline demo --snapshot {data.size} --keys …</code>: the same engine, headless.</figcaption>
</figure>
<script is:inline>
  (function () {
    var fig = document.querySelector('[data-tour-preview]');
    if (!fig || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var screen = fig.querySelector('.tp__screen');
    var started = false;
    function play(frames) {
      var i = 0;
      function next() {
        screen.innerHTML = frames[i].html;
        var ms = frames[i].ms;
        i = (i + 1) % frames.length;
        setTimeout(next, i === 0 ? ms + 1500 : ms);
      }
      next();
    }
    var io = new IntersectionObserver(function (entries) {
      if (started || !entries.some(function (e) { return e.isIntersecting; })) return;
      started = true;
      io.disconnect();
      fetch('/tour/frames.json').then(function (r) { return r.json(); }).then(function (d) { play(d.frames); }, function () {});
    });
    io.observe(fig);
  })();
</script>
<style>
  .tp { margin: 0; display: grid; gap: var(--s-2); min-width: 0; }
  .tp__bar { display: flex; gap: var(--s-4); align-items: center; border: 1px solid var(--rule-strong); border-bottom: 0; background: var(--raise); padding: 0.45rem 0.8rem; font: 400 var(--t-xs)/1 var(--font-mono); color: var(--muted); }
  .tp__bar .dim { margin-left: auto; }
  .tp__dots { color: var(--faint); letter-spacing: 0.1em; }
  .tp__screen { margin: 0; border: 1px solid var(--rule-strong); background: var(--panel); color: var(--ink); padding: 0.6rem 0.4rem; font: 400 clamp(0.52rem, 1.55vw, 0.82rem)/1.4 var(--font-mono); overflow-x: auto; white-space: pre; }
  .tp__screen :global(.h) { color: var(--dim); }
  .tp__screen :global(.s) { background: var(--lit); color: var(--lit-ink); }
  .tp__screen :global(.c) { background: var(--lit); color: var(--lit-ink); }
  .tp__screen :global(.b), .tp__screen :global(.ba) { background: var(--raise); color: var(--muted); }
  .tp__screen :global(.ba) { color: var(--lit); font-weight: 600; }
  .tp figcaption { font: 400 var(--t-xs)/1.5 var(--font-mono); }
  .tp figcaption code { font-size: 1em; }
</style>
