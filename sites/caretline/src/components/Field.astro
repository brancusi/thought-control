---
// One ASCII scene in a terminal frame, drawn by public/js/field.js on the frame clock.
// The status row reads like caretline's: the scene, the frames per second this tab shows,
// and how long a frame takes to compute here.
interface Props { scene: string; cols?: number; rows?: number; title?: string; label?: string; speed?: number; still?: number; class?: string; minCell?: number; fixedRows?: boolean }
const { scene, cols = 80, rows = 24, title, label, speed = 1, still = 2.4, class: cls, minCell = 5.2, fixedRows = false } = Astro.props;
---
<figure class:list={['term', 'field', cls]} data-field={scene} data-cols={cols} data-rows={rows} data-speed={speed} data-still={still} data-min-cell={minCell} data-fixed-rows={fixedRows ? '' : undefined}>
  <div class="term__body">
    <canvas role="img" aria-label={label ?? `${title ?? scene}, drawn in ASCII on a frame clock`}></canvas>
  </div>
  <figcaption class="status">
    <span><b>{title ?? scene}</b></span>
    <span data-stats>— fps</span>
    <button type="button" data-toggle aria-label="Pause or play this animation">pause</button>
  </figcaption>
</figure>
