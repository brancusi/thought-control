---
// The real engine in the page: public/wasm/caretline.wasm (crates/caretline-next built for
// wasm32), driven by public/js/engine.js over the same state protocol `caretline serve` speaks.
---
<div class="pg" data-playground data-wasm="/wasm/caretline.wasm">
  <div class="pg__grid">
    <section class="pg__pane pg__pane--frame term" aria-label="The frame">
      <header class="pg__bar"><span class="pg__title">view(state) → frame</span><span class="pg__mode" data-mode>loading</span></header>
      <div class="pg__screen">
        <pre class="pg__frame" data-frame aria-hidden="true">Loading the engine…</pre>
        <textarea class="pg__input" data-input aria-label="Type into the caretline engine" autocapitalize="off" autocomplete="off" autocorrect="off" spellcheck="false"></textarea>
      </div>
      <footer class="status">
        <span data-rev>rev 0</span>
        <input class="pg__scrub" type="range" min="0" max="0" value="0" step="1" data-scrub aria-label="Replay the trace to a rev" />
        <span class="pg__btns"><button type="button" data-replay>replay</button><span class="sep">·</span><button type="button" data-reset>reset</button><span class="sep">·</span><button type="button" data-copy>copy trace</button></span>
      </footer>
      <p class="pg__toast" data-status hidden></p>
    </section>
    <section class="pg__pane term" aria-label="Messages">
      <header class="pg__bar"><span class="pg__title">msg stream</span><span class="dim">update(state, msg)</span></header>
      <ol class="pg__msgs" data-msgs></ol>
    </section>
    <section class="pg__pane pg__pane--state term" aria-label="The state">
      <header class="pg__bar"><span class="pg__title">state.json</span><span class="dim">one value</span></header>
      <pre class="pg__state" data-state></pre>
    </section>
  </div>
</div>
<script is:inline src="/js/engine.js" defer></script>

<style>
  .pg__grid { display: grid; gap: var(--s-4); grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); grid-template-areas: 'frame frame' 'msgs state'; }
  @media (min-width: 64rem) { .pg__grid { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: 'frame msgs state'; } }
  @media (max-width: 40rem) { .pg__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'frame' 'msgs' 'state'; } }
  .pg__pane { display: flex; flex-direction: column; min-width: 0; position: relative; background: var(--panel); }
  .pg__pane--frame { grid-area: frame; background: var(--void); }
  .pg__pane:nth-child(2) { grid-area: msgs; }
  .pg__pane--state { grid-area: state; }
  .pg__bar { display: flex; justify-content: space-between; gap: var(--s-4); padding: 0.45rem 0.75rem; border-bottom: 1px solid var(--rule); font: 400 var(--t-xs)/1.4 var(--font-mono); color: var(--muted); }
  .pg__title { color: var(--ink); }
  .pg__mode { color: var(--lit); }
  .pg__screen { position: relative; flex: 1; cursor: text; }
  .pg__frame { border: 0; background: none; padding: 0.6rem 0.75rem; margin: 0; font-size: clamp(0.72rem, 1.5vw, 0.9rem); line-height: 1.5; white-space: pre; overflow: hidden; min-height: 12lh; user-select: none; }
  .pg__frame :global(.r-selection) { background: var(--lit); color: var(--lit-ink); }
  .pg__frame :global(.row--status) { color: var(--dim); }
  .pg__frame :global(.r-status), .pg__frame :global(.r-status_accent) { color: var(--dim); }
  .pg__frame :global(.r-status_accent) { color: var(--lit); }
  .pg__frame :global(.caret) { box-shadow: inset 0.14em 0 0 var(--lit); }
  .pg:not(.is-focused) .pg__frame :global(.caret) { box-shadow: inset 0.14em 0 0 var(--faint); }
  .pg.is-replay .pg__frame :global(.caret) { box-shadow: inset 0.14em 0 0 var(--part); }
  .pg.is-replay .pg__mode { color: var(--part); }
  .pg__input { position: absolute; inset: 0; opacity: 0; resize: none; border: 0; padding: 0; font-size: 16px; color: transparent; background: transparent; caret-color: transparent; }
  .pg.is-focused .pg__pane--frame { border-color: var(--lit-line); }
  .pg__scrub { flex: 1; min-width: 4rem; accent-color: var(--lit); height: 1rem; }
  .pg__btns { display: inline-flex; gap: 0.4rem; }
  .pg__toast { position: absolute; left: 0.75rem; right: 0.75rem; bottom: 2.6rem; margin: 0; padding: 0.4rem 0.6rem; background: var(--raise); border: 1px solid var(--rule-strong); font: 400 var(--t-xs)/1.4 var(--font-mono); color: var(--ink); }
  .pg__msgs { list-style: none; margin: 0; padding: 0.5rem 0; overflow: auto; height: 21rem; font: 400 var(--t-xs)/1.55 var(--font-mono); }
  .pg__msgs :global(li) { display: grid; grid-template-columns: 3.2em minmax(0, 1fr); gap: 0.5rem; padding: 0 0.75rem; white-space: nowrap; }
  .pg__msgs :global(li.is-future) { opacity: 0.35; }
  .pg__msgs :global(li.empty) { display: block; color: var(--dim); white-space: normal; }
  .pg__msgs :global(.rev) { color: var(--faint); text-align: right; }
  .pg__msgs :global(code) { font-size: 1em; color: var(--muted); }
  .pg__state { border: 0; height: 21rem; overflow: auto; font-size: var(--t-xs); line-height: 1.55; background: none; color: var(--muted); }
  .pg :global(.j-k) { color: var(--ink); }
  .pg :global(.j-s) { color: var(--astro-code-token-string); }
  .pg :global(.j-n) { color: var(--astro-code-token-constant); }
  .pg :global(.j-m) { color: var(--lit); }
  @media (max-width: 40rem) { .pg__msgs, .pg__state { height: 14rem; } .pg__btns .sep, .pg__btns [data-copy] { display: none; } }
</style>
