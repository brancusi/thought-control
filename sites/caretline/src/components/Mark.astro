---
// The caretline mark, drawn with the page's tokens so it follows the theme.
// The same geometry as public/brand/caretline-mark-*.svg (scripts/brand.mjs).
interface Props { size?: number; tile?: boolean; class?: string }
const { size = 28, tile = false, class: cls } = Astro.props;
const streaks: [number, number, number, number][] = [
  [-24, 12, 29, 4.2], [16, 15, 26, 3.2], [150, 13, 29, 4.2], [196, 15, 25, 3.2], [56, 16, 27, 3.4], [236, 16, 27, 3.4],
];
const r = (n: number) => Math.round(n * 100) / 100;
const polar = (a: number, rr: number) => [32 + Math.cos((a * Math.PI) / 180) * rr, 32 + Math.sin((a * Math.PI) / 180) * rr];
const poly = ([a, r0, r1, w]: number[]) => {
  const t = (a * Math.PI) / 180, nx = -Math.sin(t), ny = Math.cos(t);
  const [x0, y0] = polar(a, r0), [x1, y1] = polar(a, r1);
  return [[x0 + nx * 0.3, y0 + ny * 0.3], [x1 + (nx * w) / 2, y1 + (ny * w) / 2], [x1 - (nx * w) / 2, y1 - (ny * w) / 2], [x0 - nx * 0.3, y0 - ny * 0.3]]
    .map(([x, y]) => `${r(x)},${r(y)}`).join(' ');
};
const dots = [[-62, 19, 1.7], [112, 21, 1.7], [-118, 24, 1.4], [84, 26, 1.3]].map(([a, rr, d]) => { const [x, y] = polar(a, rr); return { x: r(x), y: r(y), d }; });
---
<svg class={cls} viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
  {tile && <rect width="64" height="64" rx="14" style="fill:var(--panel)" />}
  {streaks.map((s) => <polygon points={poly(s)} style="fill:var(--ink)" />)}
  {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.d} style="fill:var(--ink)" fill-opacity="0.7" />)}
  <rect x="29" y="13" width="6" height="38" style="fill:var(--lit)" />
</svg>
