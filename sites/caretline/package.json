{
  "name": "caretline-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "wasm": "bash scripts/wasm.sh",
    "brand": "node scripts/brand.mjs",
    "scan": "bash scripts/scan.sh",
    "deploy": "npm run build && npm run scan && wrangler deploy --config ./wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "opentype.js": "^2.0.0",
    "pagefind": "^1.5.2"
  }
}
